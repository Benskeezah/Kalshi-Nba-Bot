# Copy to .env (or export these). Nothing here is required for read-only market data.
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
# KALSHI_API_KEY_ID=            # not used yet; never commit real keys
NWS_USER_AGENT=kalshi-edge-research (you@example.com)
KALSHI_EDGE_DB=predictions.sqlite
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_FEE_MULTIPLIER=1.0
KALSHI_EDGE_SIZE=10
ODDS_API_KEY=                   # optional, free tier at the-odds-api.com; adds sportsbook lines
PROP_LINE_WEIGHT=0.5            # 0 = props from the stats model only, 1 = sportsbook lines only
KALSHI_EDGE_STATS_DB=nba_stats.sqlite
